{
  "id": "/admin.html",
  "name": "Hawkeye Admin Console",
  "short_name": "Hawkeye Admin",
  "description": "Reach, incidents, labels, pairs, push, races, social and register maintenance for Hawkeye — owner access only.",
  "start_url": "/admin.html",
  "scope": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "background_color": "#00251a",
  "theme_color": "#00482b",
  "categories": [
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "Reach",
      "url": "/admin.html?p=reach"
    },
    {
      "name": "Incidents",
      "url": "/admin.html?p=incidents"
    },
    {
      "name": "Push",
      "url": "/admin.html?p=push"
    }
  ],
  "icons": [
    {
      "src": "admin-icon-192.png?v=1",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "admin-icon-192-maskable.png?v=1",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "admin-icon-512.png?v=1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "admin-icon-512-maskable.png?v=1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
