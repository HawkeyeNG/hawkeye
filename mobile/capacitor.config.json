{
  "appId": "ng.com.hawkeye.lite",
  "appName": "Hawkeye Lite",
  "webDir": "../app",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "CapacitorUpdater": { "autoUpdate": false, "appReadyTimeout": 10000, "resetWhenUpdate": true, "statsUrl": "" },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
