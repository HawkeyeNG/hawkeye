<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- THE SPLASH HAS TO SURVIVE THE HANDOVER. The system splash (green +
             hawk) ends the instant the first frame is drawn, and this theme took
             over with no window background at all — so on a FIRST install, where
             the WebView has nothing cached and takes seconds, the hawk vanished
             and left a bare field. On a relaunch the WebView paints fast enough
             that the system splash is still what you see, which is exactly why
             it "worked on relaunch but not on install".
             Painting the SAME drawable here continues it seamlessly until the
             page draws over it. No plugin, no timers, no second splash. -->
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <!-- Hawkeye theming is opt-in via the in-app header toggle (styles.css
             [data-theme="dark"]); the CSS never follows prefers-color-scheme. With
             a DayNight theme the WebView would algorithmically darken the page to
             match system dark, which overrode that toggle and made it look broken.
             Opt the view hierarchy out of force-dark so the toggle is authoritative. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>


    <!-- Pre-Android-12 launch theme. `android:background` was the wrong hook —
         it styles the decor view, not the window, so the splash showed
         @drawable/splash on the theme's own (black) window background.
         windowBackground is what the system paints before the first frame, and
         splash_screen is a layer-list that carries the green field with it.
         Android 12+ overrides this whole style; see values-v31/styles.xml. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>