# mobile/android/app/google-services.json is COMMITTED on purpose (2026-09-16).
# Ignoring it kept it off the CI runner, so every Play bundle built there had no
# Firebase config and crashed on push registration — Lite versionCodes 8, 9 and
# 10 were rejected for it. It is public-by-design (extractable from any APK), and
# native/google-services.json, a subset of it, was already committed.

# Playwright UI-guard deps + local run output (CI installs from the lockfile)
tests/ui/node_modules/
tests/ui/report/
tests/ui/test-results/
docs/EMAIL-TEMPLATE.html

# Built APK served from /download — a 31 MB regenerable build artifact.
# Committing it would bloat this PUBLIC repo permanently; it is deployed
# straight to the host by scripts/deploy_app.sh instead.
app/download/*.apk

# Play listing screenshots — regenerable via scripts/play_screenshots.mjs
app/play-shots/

# iOS listing screenshots — regenerable via scripts/ios_screenshots.mjs
app/ios-shots/

# Register manifest signing key (private half lives in ~/hawkeye-secrets)
register-signing.key

# iOS signing material. credentials.json holds the .p12 password in clear text
# (EAS defines the format), and this repo is public.
credentials.json
native/credentials.json
*.p12
*.mobileprovision
*.p8
*.certSigningRequest

# private working documents — budgets, donor material, anything not for a public repo.
# ONE rule: a new file here is ignored without touching .gitignore again.
docs/private/

