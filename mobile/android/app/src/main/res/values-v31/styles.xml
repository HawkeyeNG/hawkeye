<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) owns the splash. It IGNORES the launch theme's window
     background, so the values/ definition alone left the platform default —
     black — behind the hawk. These three items are the whole contract:
       windowSplashScreenBackground   the field colour
       windowSplashScreenAnimatedIcon the centred mark (masked to a CIRCLE of
                                      160dp inside a 240dp canvas, which is why
                                      splash_icon.png keeps the bird inside its
                                      middle ~60%)
       postSplashScreenTheme          the theme to hand over to once loaded
-->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
