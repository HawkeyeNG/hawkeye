{
  "name": "hawkeye-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell wrapping the Hawkeye PWA (app/) into native iOS + Android.",
  "scripts": {
    "postinstall": "patch-package",
    "sync": "cap sync",
    "android": "cap run android",
    "ios": "cap run ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-firebase/messaging": "^8.4.0",
    "@capacitor-mlkit/document-scanner": "^8.1.0",
    "@capacitor-mlkit/text-recognition": "^8.1.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.25",
    "hawkeye-vision": "file:plugins/hawkeye-vision"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "@capacitor/assets": {
      "@capacitor/cli": "$@capacitor/cli",
      "sharp": "^0.35.4"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
