# node_modules regenerated by npm install. The native android/ project IS
# committed (it holds customizations like AndroidManifest permissions); its own
# android/.gitignore excludes build outputs (build/, .gradle, *.apk, local.properties).
# ios/ is generated on a Mac (cap add ios) and committed there.
node_modules/
ios/
*.log

# ...but NOT our own plugin's iOS sources. `ios/` above is meant for the
# GENERATED Capacitor project at mobile/ios; being pathless it matched
# plugins/hawkeye-vision/ios/ too, and silently kept the plugin's Swift out of
# the repo. The pod would still have built in CI — with no source files in it —
# and iOS would have come back with no scanner and no OCR while every step went
# green. Caught by `git status` showing five files staged where nine were
# expected.
!plugins/*/ios/
!plugins/*/ios/**

# Backup the icon rescaler writes; the original is in git history.
assets/*.pre-scale.png
