<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rejects every incoming call (free to the caller) and tells Hawkeye the caller's number."
            android:textSize="14sp" />

        <!-- 1. The call-screening role -->
        <TextView
            android:id="@+id/role_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/role_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make this the call-screening app" />

        <!-- 2. The gateway SIM -->
        <TextView
            android:id="@+id/sim_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Only calls to this SIM are rejected. Calls to any other SIM in this phone ring normally and are never reported."
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sim_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose the gateway SIM" />

        <!-- 3. Server and secret -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Server"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView
            android:id="@+id/secret_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textVisiblePassword|textNoSuggestions"
            android:singleLine="true" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save" />

        <Button
            android:id="@+id/test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send test event" />

        <Switch
            android:id="@+id/keep_awake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Keep the screen on while this app is open" />

        <!-- 4. What happened -->
        <TextView
            android:id="@+id/queue_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
